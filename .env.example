# Google Gemini API Keys (comma-separated for round-robin rotation)
# Get FREE keys from Google AI Studio: https://aistudio.google.com/
# Add multiple keys to avoid rate limits: KEY1,KEY2,KEY3
GEMINI_API_KEYS=YOUR_KEY_1,YOUR_KEY_2,YOUR_KEY_3
GEMINI_MODEL=gemini-3.5-flash-lite

# Text-To-Speech (TTS) Settings
# Speech rate in words per minute (normal is around 150-180)
TTS_RATE=160
# Volume level (0.0 to 1.0)
TTS_VOLUME=1.0
