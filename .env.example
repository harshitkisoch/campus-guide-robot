# ==============================================================================
# CAMPUS GUIDE ROBOT — ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# Copy this file to .env and replace with your actual API keys!
# ==============================================================================

# 1. Google Gemini API Keys (For Robot Intelligence & Persona Generation)
# Get FREE keys from: https://aistudio.google.com/
# Pro Tip: Add multiple keys separated by commas for automatic round-robin rotation!
GEMINI_API_KEYS=YOUR_GEMINI_KEY_1,YOUR_GEMINI_KEY_2
GEMINI_MODEL=gemini-1.5-flash

# 2. Sarvam AI API Key (For Natural Hindi Speech Output & Priya Female Voice)
# Get your API key from: https://dashboard.sarvam.ai/
SARVAM_API_KEY=YOUR_SARVAM_API_KEY_HERE

# 3. Audio Output Mode
# Options: 
#   'sarvam'    -> Recommended: High-quality natural Hindi TTS voice (Priya speaker)
#   'bluetooth' -> Local laptop sound interface using Microsoft Zira / SAPI5
#   'esp32'     -> On-chip ESP8266SAM speech synthesis via HW-104 speaker module
OUTPUT_DEVICE=sarvam

# 4. Speech Synthesis Rate & Volume Settings
TTS_RATE=160
TTS_VOLUME=1.0

# 5. Central WebSocket Router Settings (Defaults)
WS_HOST=0.0.0.0
WS_PORT=8765
